#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

CRONTAB_FILE="/etc/crontabs/root"

# Identify our crontab entries by the command pattern (not comments,
# since OpenWrt crontab upgrades may strip comments)

# Ensure crontab file ends with a newline before appending.
# Without this, if the last line has no trailing newline, the new entry
# would be concatenated onto it, producing a broken crontab.
cron_ensure_newline() {
	[ -s "$CRONTAB_FILE" ] || return 0
	# $(tail -c1) strips trailing newlines in command substitution,
	# so if the file ends with \n the result is empty, otherwise non-empty.
	[ -n "$(tail -c1 "$CRONTAB_FILE")" ] && echo "" >> "$CRONTAB_FILE"
}

cf_ip_cron_ensure() {
	# Ensure cron is enabled and running
	/etc/init.d/cron enable 2>/dev/null || /etc/init.d/crond enable 2>/dev/null || true
	/etc/init.d/cron start 2>/dev/null || /etc/init.d/crond start 2>/dev/null || true
}

cf_ip_cron_add() {
	local expr="$1"
	cf_ip_cron_ensure
	# Remove any existing cf-ip-auto --run entry
	cf_ip_cron_remove
	mkdir -p /etc/crontabs
	cron_ensure_newline
	printf '%s /usr/bin/cf-ip-auto --run >/dev/null 2>&1\n' \
		"$expr" >> "$CRONTAB_FILE"
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true
	logger -t cf_ip -p daemon.info "crontab: scheduled with expression '${expr}'"
}

cf_ip_cron_remove() {
	sed -i '/cf-ip-auto --run/d' "$CRONTAB_FILE" 2>/dev/null || true
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true
	logger -t cf_ip -p daemon.info "crontab: removed scheduled entries"
}

# Plugin sync cron management
cf_ip_cron_add_plugin() {
	local plugin="$1" expr="$2"
	cf_ip_cron_ensure
	# Remove existing entries for this plugin
	cf_ip_cron_remove_plugin "$plugin"
	mkdir -p /etc/crontabs
	cron_ensure_newline
	printf '%s /usr/bin/cf-ip-auto --sync %s >/dev/null 2>&1\n' \
		"$expr" "$plugin" >> "$CRONTAB_FILE"
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true
	logger -t cf_ip -p daemon.info "crontab: ${plugin}-sync scheduled with expression '${expr}'"
}

cf_ip_cron_remove_plugin() {
	local plugin="$1"
	sed -i "/cf-ip-auto --sync ${plugin}/d" "$CRONTAB_FILE" 2>/dev/null || true
	/etc/init.d/cron reload 2>/dev/null || /etc/init.d/crond reload 2>/dev/null || true
	logger -t cf_ip -p daemon.info "crontab: removed ${plugin}-sync scheduled entries"
}

cf_ip_cron_remove_all_plugins() {
	cf_ip_cron_remove_plugin openclash
	cf_ip_cron_remove_plugin passwall
}

start_service() {
	local enabled cfst_persist cron_interval cron_custom startup_delay
	config_load cf_ip
	config_get_bool enabled main enabled 0

	[ "$enabled" -eq 0 ] && return 0

	if ! validate_cf_ip 2>/dev/null; then
		logger -t cf_ip -p daemon.err "Configuration validation failed, refusing to start"
		return 1
	fi

	mkdir -p /etc/cf_ip /tmp/cf_ip

	# Handle CFST sysupgrade persistence
	config_get_bool cfst_persist main cfst_persist 1
	if [ "$cfst_persist" -eq 1 ]; then
		grep -qxF '/usr/bin/cfst' /etc/sysupgrade.conf 2>/dev/null || echo '/usr/bin/cfst' >> /etc/sysupgrade.conf
	else
		sed -i '\|^/usr/bin/cfst$|d' /etc/sysupgrade.conf 2>/dev/null || true
	fi

	# Pre-download/update CFST in background
	(cf-ip-auto --download-cfst >/dev/null 2>&1) &

	# Get schedule configuration
	config_get cron_interval main cron_interval "6h"
	config_get cron_custom main cron_custom ""
	config_get startup_delay main startup_delay ""

	# Resolve to cron expression via cf-ip-auto
	local cron_expr
	cron_expr="$(cf-ip-auto --to-cron "$cron_interval" "$cron_custom")" || {
		logger -t cf_ip -p daemon.err "crontab: failed to convert schedule to cron expression, falling back to daemon"
		# Fallback: start as traditional daemon — will be replaced on next config save
		return 1
	}

	# Schedule via crontab
	cf_ip_cron_add "$cron_expr"

	# Set up plugin sync cron entries
	local sync_interval sync_custom sync_expr target_domain
	for plugin in openclash passwall; do
		# Only add sync cron if target_domain is configured
		config_get target_domain "$plugin" target_domain ""
		[ -z "$target_domain" ] && continue

		config_get sync_interval "$plugin" sync_interval ""
		config_get sync_custom "$plugin" sync_custom ""

		# Empty sync_interval means follow main program schedule
		if [ -z "$sync_interval" ]; then
			sync_interval="$cron_interval"
			sync_custom="$cron_custom"
		fi

		sync_expr="$(cf-ip-auto --to-cron "$sync_interval" "$sync_custom")" || {
			logger -t cf_ip -p daemon.warn "crontab: failed to convert ${plugin} sync schedule, skipping"
			continue
		}

		cf_ip_cron_add_plugin "$plugin" "$sync_expr"
	done

	# Let cf-ip-auto apply its own startup delay so numeric and random modes stay consistent.
	case "$startup_delay" in
		""|0)
			;;
		*)
			(/usr/bin/cf-ip-auto --run >/dev/null 2>&1) &
			logger -t cf_ip -p daemon.info "startup: first run scheduled with delay '${startup_delay}'"
			;;
	esac

	# Write initial status for crontab-managed mode
	cf-ip-auto --write-status
}

stop_service() {
	cf_ip_cron_remove
	cf_ip_cron_remove_all_plugins
	if [ -f /etc/cf_ip/status.json ]; then
		sed -i 's/"running":true/"running":false/' /etc/cf_ip/status.json 2>/dev/null
	fi
}

service_triggers() {
	procd_add_reload_trigger "cf_ip"
	procd_add_validation validate_cf_ip
}

reload_service() {
	restart
}

validate_cf_ip() {
	uci_validate_section cf_ip service main \
		'enabled:bool' 'mode:string' 'ip_count:uinteger' \
		'ip_type:string' 'speedtest_protocol:string' \
		'speedtest_cfcolo:string' 'speedtest_dn:uinteger' \
		'speedtest_tll:uinteger' 'speedtest_tl:uinteger' 'stop_service:bool' \
		'startup_delay:string' 'auto_update:bool' \
		'self_update_url:string' 'download_retries:uinteger' \
		'download_retry_delay:uinteger' 'github_mirror:string' \
		'verbose:bool' 'work_dir:string' 'cron_interval:string' \
		'cron_custom:string' \
		'cfst_persist:bool'

	uci_validate_section cf_ip passwall passwall \
		'target_domain:string' 'name_suffix:string' \
		'sync_interval:string' 'sync_custom:string'

	uci_validate_section cf_ip openclash openclash \
		'config:string' 'target_domain:string' \
		'name_suffix:string' 'transport_filter:string' \
		'backup_count:uinteger' \
		'sync_interval:string' 'sync_custom:string'
}
