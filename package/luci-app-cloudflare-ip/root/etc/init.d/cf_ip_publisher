#!/bin/sh /etc/rc.common
START=98
STOP=12
USE_PROCD=1

get_lan_ipv4() {
	ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null
}

is_private_ipv4() {
	case "$1" in
		10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
		*) return 1 ;;
	esac
}

start_service() {
	local enabled bind port docroot
	config_load cf_ip
	config_get_bool enabled lan enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get bind lan bind_address ''
	config_get port lan port 12345
	[ -n "$bind" ] || bind="$(get_lan_ipv4)"
	is_private_ipv4 "$bind" || { logger -t cf_ip_publisher -p daemon.err "refusing non-LAN bind: $bind"; return 1; }
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 1024 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 1
	docroot=/tmp/cf_ip/publish
	mkdir -p "$docroot"
	[ -x /usr/sbin/uhttpd ] || { logger -t cf_ip_publisher -p daemon.err 'uhttpd missing'; return 1; }
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -p "$bind:$port" -h "$docroot" -D -S -R
	procd_set_param respawn 3600 5 3
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger cf_ip; }
