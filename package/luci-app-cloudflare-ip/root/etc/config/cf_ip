config service 'main'
	option enabled '0'
	option mode 'passwall'
	option ip_count '4'
	option ip_type 'ipv4'
	option speedtest_protocol 'tcp'
	option speedtest_cfcolo ''
	option speedtest_dn '8'
	option speedtest_dt '6'
	option speedtest_threads '200'
	option speedtest_ping_count '3'
	option speedtest_tll '40'
	option speedtest_tl ''
	option stop_service '1'
	option startup_delay ''
	option auto_update '0'
	option self_update_url 'https://raw.githubusercontent.com/hello-yunshu/luci-app-cloudflare-ip/main/package/luci-app-cloudflare-ip/root/usr/bin/cf-ip-auto'
	option download_retries '3'
	option download_retry_delay '5'
	option github_mirror ''
	option verbose '0'
	option work_dir ''
	option cron_interval '6h'
	option cron_custom ''
	option cfst_persist '1'
	option candidate_budget '128'
	option probe_top_count '8'
	option probe_concurrency '4'
	option probe_timeout '5'
	option measurement_timeout '60'
	list builtin_sources 'cloudflare-official-v4'
	list builtin_sources 'cloudflare-official-v6'

config rill 'rill'
	option enabled '0'
	option mode 'shadow'
	option adapter '/usr/libexec/cf-ip/cf-ip-rill'
	option state_file '/etc/cf_ip/rill-state.json'
	option timeout_ms '2000'

config lan 'lan'
	option enabled '0'
	option bind_address ''
	option port '12345'

config passwall 'passwall'
	option target_domain ''
	option name_suffix ' [CF-{n}]'

config openclash 'openclash'
	option config '/etc/openclash/config/config.yaml'
	option target_domain ''
	option name_suffix ' [CF-{n}]'
	option transport_filter ''
	option backup_count '3'
