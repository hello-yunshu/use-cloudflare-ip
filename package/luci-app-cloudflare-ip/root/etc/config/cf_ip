config service 'main'
	option enabled '0'
	option mode 'passwall'
	option ip_count '4'
	option ip_type 'ipv4'
	option speedtest_protocol 'tcp'
	option speedtest_cfcolo ''
	option speedtest_dn '10'
	option speedtest_tll '40'
	option speedtest_tl ''
	option stop_service '1'
	option startup_delay ''
	option auto_update '1'
	option self_update_url 'https://raw.githubusercontent.com/hello-yunshu/use-cloudflare-ip/main/package/luci-app-cloudflare-ip/root/usr/bin/cf-ip-auto'
	option download_retries '3'
	option download_retry_delay '5'
	option github_mirror ''
	option verbose '0'
	option work_dir ''
	option cron_interval '6h'
	option cfst_persist '1'

config passwall 'passwall'
	option target_domain ''
	option name_suffix ' [CF-{n}]'
	option sync_interval ''
	option sync_custom ''

config openclash 'openclash'
	option config '/etc/openclash/config/config.yaml'
	option target_domain ''
	option name_suffix ' [CF-{n}]'
	option transport_filter ''
	option backup_count '3'
	option sync_interval ''
	option sync_custom ''
