msgstr "Enable Service"

msgid "Run the background service to periodically optimize Cloudflare IPs."
msgstr "Run the background service to periodically optimize Cloudflare IPs."

msgid "Run Interval (minutes)"
msgstr "Run Interval (minutes)"

msgid "How often the service runs speed tests. Recommended: 360 (6 hours). Avoid below 60."
msgstr "How often the service runs speed tests. Recommended: 360 (6 hours). Avoid below 60."

msgid "Speed Test"
msgstr "Speed Test"

msgid "Select which proxy service to update."
msgstr "Select which proxy service to update."

msgid "IP Count"
msgstr "IP Count"

msgid "Number of best IPs to keep. If fewer IPs found, the fastest one is reused."
msgstr "Number of best IPs to keep. If fewer IPs found, the fastest one is reused."

msgid "Select which IP addresses to test."
msgstr "Select which IP addresses to test."

msgid "Speed Test Protocol"
msgstr "Speed Test Protocol"

msgid "TCPing measures TCP latency. HTTPing measures HTTP response latency and supports data center filtering."
msgstr "TCPing measures TCP latency. HTTPing measures HTTP response latency and supports data center filtering."

msgid "Data Center Filter"
msgstr "Data Center Filter"

msgid "Filter by Cloudflare data center in HTTPing mode. Comma-separated, e.g. HKG,NRT,LAX. Only effective with HTTPing."
msgstr "Filter by Cloudflare data center in HTTPing mode. Comma-separated, e.g. HKG,NRT,LAX. Only effective with HTTPing."

msgid "Download Test Count"
msgstr "Download Test Count"

msgid "Number of IPs to test download speed."
msgstr "Number of IPs to test download speed."

msgid "Average Latency Floor (ms)"
msgstr "Average Latency Floor (ms)"

msgid "Skip IPs with average latency below this value. Useful for filtering out fake/blocked IPs with suspiciously low latency."
msgstr "Skip IPs with average latency below this value. Useful for filtering out fake/blocked IPs with suspiciously low latency."

msgid "Average Latency Ceiling (ms)"
msgstr "Average Latency Ceiling (ms)"

msgid "Skip IPs with average latency above this value. Leave empty for no upper limit."
msgstr "Skip IPs with average latency above this value. Leave empty for no upper limit."

msgid "Stop Service Before Test"
msgstr "Stop Service Before Test"

msgid "Stop the proxy service before speed testing to avoid interference, and restart after updating."
msgstr "Stop the proxy service before speed testing to avoid interference, and restart after updating."

msgid "service action failed"
msgstr "service action failed"

msgid "Random delay upper bound in seconds. Useful for staggering startup on multiple routers. Empty or 'random' = 0~300s, '0' = no delay."
msgstr "Random delay upper bound in seconds. Useful for staggering startup on multiple routers. Empty or 'random' = 0~300s, '0' = no delay."

