msgid "OpenClash Settings"
msgstr "OpenClash Settings"

msgid "OpenClash mode modifies the YAML configuration file. It finds proxies whose server matches the target domain, generates [CF-1], [CF-2] variants, and keeps servername/Host as the original domain. Supports vless/vmess/trojan with tls:true or network ws/xhttp/grpc/h2/http."
msgstr "OpenClash mode modifies the YAML configuration file. It finds proxies whose server matches the target domain, generates [CF-1], [CF-2] variants, and keeps servername/Host as the original domain. Supports vless/vmess/trojan with tls:true or network ws/xhttp/grpc/h2/http."

msgid "Config File Path"
msgstr "Config File Path"

msgid "Path to the OpenClash YAML configuration file."
msgstr "Path to the OpenClash YAML configuration file."

msgid "Only OpenClash proxies whose server matches this domain will be updated. Comma-separated for multiple domains."
msgstr "Only OpenClash proxies whose server matches this domain will be updated. Comma-separated for multiple domains."

msgid "Proxy Name Suffix"
msgstr "Proxy Name Suffix"

msgid "Suffix appended to the original proxy name. Placeholders: {n} = sequence number, {ip} = IP address. Leave empty to keep original names."
msgstr "Suffix appended to the original proxy name. Placeholders: {n} = sequence number, {ip} = IP address. Leave empty to keep original names."

msgid "Transport Filter"
msgstr "Transport Filter"

msgid "Only update proxies with the specified transport protocol. Comma-separated. Values: ws, grpc, xhttp, h2, http. Leave empty to update all supported proxies."
msgstr "Only update proxies with the specified transport protocol. Comma-separated. Values: ws, grpc, xhttp, h2, http. Leave empty to update all supported proxies."

