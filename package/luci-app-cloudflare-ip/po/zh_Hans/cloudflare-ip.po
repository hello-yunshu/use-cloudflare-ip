msgstr "自动更新脚本"

msgid "Auto-check and update script on startup."
msgstr "启动时自动检查并更新脚本。"

msgid "Self Update URL"
msgstr "更新地址"

msgid "URL to download the latest script version."
msgstr "下载最新脚本版本的 URL。"

