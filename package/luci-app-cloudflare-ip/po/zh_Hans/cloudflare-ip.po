msgid "Service restarted."
msgstr "服务已重启。"

msgid "Failed to restart service: "
msgstr "重启服务失败："

msgid "Restart"
msgstr "重启"

msgid "Running..."
msgstr "运行中..."

msgid "Speedtest failed: %s"
msgstr "测速失败：%s"

msgid "Run Speedtest"
msgstr "立即测速"

