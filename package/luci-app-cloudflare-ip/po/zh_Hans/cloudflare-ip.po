msgid "Cloudflare IP Optimization"
msgstr "Cloudflare IP 优选"

msgid "Settings"
msgstr "设置"

msgid "Overview"
msgstr "概览"

msgid "Service"
msgstr "服务"

msgid "Enable Service"
msgstr "启用服务"

msgid "Run the background service to periodically optimize Cloudflare IPs."
msgstr "运行后台服务，定期优选 Cloudflare IP。"

msgid "Run Schedule"
msgstr "运行计划"

msgid "Select how often the speed test runs. The service computes the next run time automatically."
msgstr "选择测速运行频率，服务会自动计算下次运行时间。"

msgid "Every 6 hours (recommended)"
msgstr "每 6 小时（推荐）"

msgid "Every hour"
msgstr "每小时"

msgid "Every 30 minutes"
msgstr "每 30 分钟"

msgid "Every 15 minutes"
msgstr "每 15 分钟"

msgid "Daily at 3:00 AM"
msgstr "每天凌晨 3:00"

msgid "Daily at 3:00 AM & 3:00 PM"
msgstr "每天凌晨 3:00 和下午 3:00"

msgid "Every 6 hours at :00"
msgstr "每 6 小时整点"

msgid "Custom..."
msgstr "自定义..."

msgid "Custom Schedule"
msgstr "自定义计划"

msgid "Cron duration (e.g. 6h, 30m) or 5-field crontab expression."
msgstr "可转换为 cron 的时长（如 6h、30m）或 5 字段 crontab 表达式。"

msgid "Speed Test"
msgstr "测速"

msgid "Mode"
msgstr "模式"

msgid "Select which proxy service to update."
msgstr "选择要更新的代理服务。"

msgid "None (No proxy service detected)"
msgstr "无（未检测到代理服务）"

msgid "PassWall or OpenClash is not installed. Please install one before using this service."
msgstr "未安装 PassWall 或 OpenClash，请先安装其中之一再使用此服务。"

msgid "IP Count"
msgstr "IP 数量"

msgid "Number of best IPs to keep. If fewer IPs found, the fastest one is reused."
msgstr "保留的优选 IP 数量。如果测速结果不足，会用最快的 IP 自动补齐。"

msgid "IP Type"
msgstr "IP 类型"

msgid "Select which IP addresses to test."
msgstr "选择要测速的 IP 地址类型。"

msgid "Both"
msgstr "双栈"

msgid "Speed Test Protocol"
msgstr "测速协议"

msgid "HTTPing supports data center filtering; TCPing does not."
msgstr "HTTPing 支持数据中心筛选，TCPing 不支持。"

msgid "Data Center Filter"
msgstr "数据中心筛选"

msgid "Filter by Cloudflare data center in HTTPing mode. Comma-separated, e.g. HKG,NRT,LAX. Only effective with HTTPing."
msgstr "HTTPing 模式下按 Cloudflare 数据中心筛选。逗号分隔，如 HKG,NRT,LAX。仅 HTTPing 模式生效。"

msgid "Download Test Count"
msgstr "下载测速数量"

msgid "Number of IPs to test download speed."
msgstr "测试下载速度的 IP 数量。"

msgid "Average Latency Floor (ms)"
msgstr "平均延迟下限（ms）"

msgid "Skip IPs with average latency below this value."
msgstr "跳过平均延迟低于此值的 IP。"

msgid "Average Latency Ceiling (ms)"
msgstr "平均延迟上限（ms）"

msgid "Skip IPs with average latency above this value. Leave empty for no upper limit."
msgstr "跳过平均延迟超过此值的 IP。留空表示不设上限。"

msgid "Stop Service Before Test"
msgstr "测速前停止服务"

msgid "Stop the proxy service before speed testing to avoid interference, and restart after updating."
msgstr "测速前停止代理服务以避免干扰，更新配置后自动重启。"

msgid "Keep CFST Across Upgrades"
msgstr "升级时保留 CFST"

msgid "Preserve CFST binary during OpenWrt sysupgrade so it survives system upgrades."
msgstr "在 OpenWrt 系统升级时保留 CFST 二进制文件，升级后无需重新下载。"

msgid "Configuration saved and applied."
msgstr "配置已保存并应用。"

msgid "Configuration saved. Restarting service..."
msgstr "配置已保存。正在重启服务..."

msgid "Configuration applied and service is ready."
msgstr "配置已应用，服务就绪。"

msgid "Failed to apply configuration: "
msgstr "应用配置失败："

msgid "service action failed"
msgstr "服务操作失败"

msgid "Speedtest Running"
msgstr "测速进行中"

msgid "Service Running"
msgstr "服务运行中"

msgid "Service Stopped"
msgstr "服务已停止"

msgid "Cloudflare IP speedtest is in progress, please wait..."
msgstr "Cloudflare IP 测速正在进行中，请稍候..."

msgid "Cloudflare IP optimization service is active and running."
msgstr "Cloudflare IP 优选服务正在运行。"

msgid "Cloudflare IP optimization service is not running. Click Start to begin."
msgstr "Cloudflare IP 优选服务未运行。点击启动开始。"

msgid "Best IP Count"
msgstr "优选 IP 数量"

msgid "Speedtest Protocol"
msgstr "测速协议"

msgid "CFST Version"
msgstr "CFST 版本"

