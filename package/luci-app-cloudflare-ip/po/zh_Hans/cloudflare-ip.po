msgstr "自动更新失败："

msgid "Script updated to version %s."
msgstr "脚本已更新至版本 %s。"

msgid "Script is already up to date."
msgstr "脚本已是最新版本。"

msgid "Download"
msgstr "下载"

msgid "GitHub Mirror"
msgstr "GitHub 镜像"

msgid "GitHub download proxy URL. Leave empty for direct downloads. Must end with /."
msgstr "GitHub 下载代理 URL。留空直接从 GitHub 下载。必须以 / 结尾。"

msgid "Download Retries"
msgstr "下载重试次数"

msgid "Number of retry attempts for GitHub downloads."
msgstr "GitHub 下载重试次数。"

msgid "Retry Delay (seconds)"
msgstr "重试间隔（秒）"

msgid "Seconds to wait between download retries."
msgstr "下载重试之间的等待秒数。"

msgid "Startup"
msgstr "启动"

msgid "Startup Delay"
msgstr "启动延迟"

msgid "Random delay upper bound (seconds). Empty/random = 0~300s, 0 = no delay."
msgstr "随机延迟上限（秒）。留空/random = 0~300秒，0 = 不等待。"

msgid "Verbose Logging"
msgstr "详细日志"

msgid "Output detailed progress logs."
msgstr "输出详细的过程日志。"

msgid "Work Directory"
msgstr "工作目录"

msgid "Leave empty to use the script directory."
msgstr "留空使用脚本所在目录。"

msgid "Service action completed, but speedtest is still in progress. Refreshing current status."
msgstr "服务操作已完成，但测速仍在进行中。正在刷新状态。"

