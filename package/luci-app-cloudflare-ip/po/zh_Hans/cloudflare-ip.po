msgstr "更新中..."

msgid "Downloading..."
msgstr "下载中..."

msgid "Updating CFST, please wait..."
msgstr "正在更新 CFST，请耐心等待..."

msgid "Downloading CFST, please wait..."
msgstr "正在下载 CFST，请耐心等待..."

msgid "CFST operation failed: "
msgstr "CFST 操作失败："

