msgid "OpenClash Not Found"
msgstr "未找到 OpenClash"

msgid "OpenClash is not installed. Please install OpenClash before using this feature."
msgstr "未安装 OpenClash，请先安装 OpenClash 再使用此功能。"

msgid "OpenClash Settings"
msgstr "OpenClash 设置"

msgid "Config File Path"
msgstr "配置文件路径"

msgid "Path to the OpenClash YAML configuration file."
msgstr "OpenClash YAML 配置文件路径。"

msgid "Only OpenClash proxies whose server matches this domain will be updated. Comma-separated for multiple domains."
msgstr "只更新 server 匹配此域名的 OpenClash 代理。逗号分隔支持多域名。"

msgid "Proxy Name Suffix"
msgstr "代理名称后缀"

msgid "Suffix appended to the original proxy name. Placeholders: {n} = sequence number, {ip} = IP address. Leave empty to keep original names."
msgstr "修改代理后在原始名称后追加的后缀。占位符：{n} = 序号，{ip} = IP 地址。留空不修改名称。"

msgid "Transport Filter"
msgstr "传输协议过滤"

msgid "Only update proxies with the specified transport protocol. Comma-separated. Values: ws, grpc, xhttp, h2, http. Leave empty to update all supported proxies."
msgstr "只更新指定传输协议的代理节点。逗号分隔。可选值：ws、grpc、xhttp、h2、http。留空更新所有支持的节点。"

msgid "Backup Count"
msgstr "备份数量"

msgid "Number of OpenClash config backups to keep."
msgstr "OpenClash 配置备份保留数量。"

msgid "Config Backups"
msgstr "配置备份"

msgid "No backups available. Backups are created automatically when the config is updated."
msgstr "暂无备份。更新配置时会自动创建备份。"

msgid "Backup Time"
msgstr "备份时间"

msgid "Size"
msgstr "大小"

msgid "Actions"
msgstr "操作"

msgid "Confirm Restore"
msgstr "确认恢复"

msgid "Are you sure you want to restore this backup? A backup of the current configuration will be created first."
msgstr "确定要恢复此备份吗？恢复前会先创建当前配置的备份。"

msgid "Cancel"
msgstr "取消"

msgid "Restoring..."
msgstr "恢复中..."

msgid "Please wait..."
msgstr "请稍候..."

msgid "Backup restored successfully."
msgstr "备份恢复成功。"

msgid "Restore failed: "
msgstr "恢复失败："

msgid "Restore"
msgstr "恢复"

msgid "Confirm Delete"
msgstr "确认删除"

msgid "Are you sure you want to delete this backup?"
msgstr "确定要删除此备份吗？"

msgid "Backup deleted"
msgstr "备份已删除"

msgid "Delete"
msgstr "删除"

msgid "PassWall Not Found"
msgstr "未找到 PassWall"

msgid "PassWall is not installed. Please install PassWall before using this feature."
msgstr "未安装 PassWall，请先安装 PassWall 再使用此功能。"

msgid "PassWall Settings"
msgstr "PassWall 设置"

msgid "Target Domain"
msgstr "目标域名"

msgid "Only PassWall nodes whose address equals this domain will be updated. Comma-separated for multiple domains."
msgstr "只更新 address 等于此域名的 PassWall 节点。逗号分隔支持多域名。"

msgid "Node Name Suffix"
msgstr "节点名称后缀"

msgid "Suffix appended to the original node name. Placeholders: {n} = sequence number, {ip} = IP address. Leave empty to keep original names."
msgstr "修改节点后在原始名称后追加的后缀。占位符：{n} = 序号，{ip} = IP 地址。留空不修改名称。"

