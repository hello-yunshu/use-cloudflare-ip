msgid "Cloudflare IP - OpenClash"
msgstr "Cloudflare IP - OpenClash"

msgid "OpenClash Settings"
msgstr "OpenClash 设置"

msgid "OpenClash mode modifies the YAML configuration file. It finds proxies whose server matches the target domain, generates [CF-1], [CF-2] variants, and keeps servername/Host as the original domain. Supports vless/vmess/trojan with tls:true or network ws/xhttp/grpc/h2/http."
msgstr "OpenClash 模式修改 YAML 配置文件。找到 server 匹配目标域名的代理，生成 [CF-1]、[CF-2] 变体，保留 servername/Host 为原域名。支持 vless/vmess/trojan 且 tls:true 或 network ws/xhttp/grpc/h2/http。"

msgid "Config File Path"
msgstr "配置文件路径"

msgid "Path to the OpenClash YAML configuration file."
msgstr "OpenClash YAML 配置文件路径。"

msgid "Only OpenClash proxies whose server matches this domain will be updated. Comma-separated for multiple domains."
msgstr "只更新 server 匹配此域名的 OpenClash 代理。逗号分隔支持多域名。"

msgid "Proxy Name Suffix"
msgstr "代理名称后缀"

msgid "Suffix appended to the original proxy name. Placeholders: {n} = sequence number, {ip} = IP address. Leave empty to keep original names."
msgstr "修改代理后在原始名称后追加的后缀。占位符：{n} = 序号，{ip} = IP 地址。留空不修改名称。"

msgid "Transport Filter"
msgstr "传输协议过滤"

msgid "Only update proxies with the specified transport protocol. Comma-separated. Values: ws, grpc, xhttp, h2, http. Leave empty to update all supported proxies."
msgstr "只更新指定传输协议的代理节点。逗号分隔。可选值：ws、grpc、xhttp、h2、http。留空更新所有支持的节点。"

msgid "Backup Count"
msgstr "备份数量"

msgid "Number of OpenClash config backups to keep."
msgstr "OpenClash 配置备份保留数量。"

msgid "Cloudflare IP Optimization"
msgstr "Cloudflare IP 优选"

msgid "Configure the Cloudflare IP speed test and optimization service."
msgstr "配置 Cloudflare IP 测速优选服务。"

msgid "Service"
msgstr "服务"

msgid "Enable Service"
msgstr "启用服务"

msgid "Run the background service to periodically optimize Cloudflare IPs."
msgstr "运行后台服务，定期优选 Cloudflare IP。"

msgid "Run Interval (minutes)"
msgstr "运行间隔（分钟）"

msgid "How often the service runs speed tests. Recommended: 360 (6 hours). Avoid below 60."
msgstr "服务运行测速的间隔时间。推荐：360（6小时）。不建议低于60。"

msgid "Speed Test"
msgstr "测速"

msgid "Select which proxy service to update."
msgstr "选择要更新的代理服务。"

msgid "IP Count"
msgstr "IP 数量"

msgid "Number of best IPs to keep. If fewer IPs found, the fastest one is reused."
msgstr "保留的优选 IP 数量。如果测速结果不足，会用最快的 IP 自动补齐。"

msgid "Select which IP addresses to test."
msgstr "选择要测速的 IP 地址类型。"

msgid "Speed Test Protocol"
msgstr "测速协议"

msgid "TCPing measures TCP latency. HTTPing measures HTTP response latency and supports data center filtering."
msgstr "TCPing 测 TCP 连接延迟，速度快。HTTPing 测 HTTP 响应延迟，更贴近实际使用场景，支持数据中心筛选。"

msgid "Data Center Filter"
msgstr "数据中心筛选"

msgid "Filter by Cloudflare data center in HTTPing mode. Comma-separated, e.g. HKG,NRT,LAX. Only effective with HTTPing."
msgstr "HTTPing 模式下按 Cloudflare 数据中心筛选。逗号分隔，如 HKG,NRT,LAX。仅 HTTPing 模式生效。"

msgid "Download Test Count"
msgstr "下载测速数量"

msgid "Number of IPs to test download speed."
msgstr "测试下载速度的 IP 数量。"

msgid "Average Latency Limit (ms)"
msgstr "平均延迟上限（ms）"

msgid "Skip IPs with average latency above this limit."
msgstr "跳过平均延迟超过此限制的 IP。"

msgid "Stop Service Before Test"
msgstr "测速前停止服务"

msgid "Stop the proxy service before speed testing to avoid interference, and restart after updating."
msgstr "测速前停止代理服务以避免干扰，更新配置后自动重启。"

msgid "service action failed"
msgstr "服务操作失败"

msgid "Random delay upper bound in seconds. Useful for staggering startup on multiple routers. Empty or 'random' = 0~300s, '0' = no delay."
msgstr "随机延迟上限（秒）。多台路由器同时运行时可错开启动。留空或 random = 0~300秒，0 = 不等待。"

msgid "Both"
msgstr "双栈"

msgid "Download CFST"
msgstr "下载 CFST"

msgid "Update CFST"
msgstr "更新 CFST"

msgid "Downloading..."
msgstr "下载中..."

msgid "CFST download failed: "
msgstr "CFST 下载失败："

msgid "CFST updated successfully."
msgstr "CFST 更新成功。"

msgid "None (No proxy service detected)"
msgstr "无（未检测到代理服务）"

msgid "PassWall or OpenClash is not installed. Please install one before using this service."
msgstr "未安装 PassWall 或 OpenClash，请先安装其中之一再使用此服务。"

msgid "Run Schedule"
msgstr "运行计划"

msgid "Select how often the speed test runs. The service computes the next run time automatically."
msgstr "选择测速运行频率，服务会自动计算下次运行时间。"

msgid "Every 6 hours (recommended)"
msgstr "每 6 小时（推荐）"

msgid "Every hour"
msgstr "每小时"

msgid "Every 30 minutes"
msgstr "每 30 分钟"

msgid "Every 15 minutes"
msgstr "每 15 分钟"

msgid "Daily at 3:00 AM"
msgstr "每天凌晨 3:00"

msgid "Daily at 3:00 AM & 3:00 PM"
msgstr "每天凌晨 3:00 和下午 3:00"

msgid "Every 6 hours at :00"
msgstr "每 6 小时整点"

msgid "Custom..."
msgstr "自定义..."

msgid "Custom Schedule"
msgstr "自定义计划"

msgid "Enter a duration (e.g. 6h, 30m, 1h30m) or a 5-field crontab expression. Comma-separated lists supported (e.g. 0 3,6 * * *)."
msgstr "输入时长（如 6h、30m、1h30m）或 5 字段 crontab 表达式。支持逗号分隔列表（如 0 3,6 * * *）。"

msgid "CFST (CloudflareSpeedTest)"
msgstr "CFST (CloudflareSpeedTest)"

msgid "CFST operation failed: "
msgstr "CFST 操作失败："

msgid "CloudflareSpeedTest (CFST) is the core speed test tool. It will be automatically downloaded when the service starts."
msgstr "CloudflareSpeedTest (CFST) 是核心测速工具，服务启动时会自动下载。"

msgid "Keep CFST Across Upgrades"
msgstr "升级时保留 CFST"

msgid "Preserve CFST binary during OpenWrt sysupgrade so it survives system upgrades."
msgstr "在 OpenWrt 系统升级时保留 CFST 二进制文件，升级后无需重新下载。"

msgid "Updating..."
msgstr "更新中..."
