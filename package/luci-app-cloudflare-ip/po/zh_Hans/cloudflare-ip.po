msgid "Manually check for and install the latest script version."
msgstr "手动检查并安装最新脚本版本。"

msgid "Update Script"
msgstr "更新脚本"

msgid "Checking for script updates, this may take a moment. Please wait..."
msgstr "正在检查脚本更新，可能需要一点时间，请耐心等待..."

