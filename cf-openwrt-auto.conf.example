# 复制本文件为 cf-openwrt-auto.conf，并和 cf-openwrt-auto.sh 放在同一目录。
# 脚本会自动读取同目录的 cf-openwrt-auto.conf。
#
# Copy this file to cf-openwrt-auto.conf and keep it in the same directory as
# cf-openwrt-auto.sh. The script automatically loads cf-openwrt-auto.conf from
# its own directory.

# 推荐定时运行频率：
#   建议每 6 小时运行一次：0 */6 * * * /path/to/cf-openwrt-auto.sh
#   网络环境很稳定可以改成每天 1 次；波动明显可以改成每 3 小时 1 次。
#   不建议低于每小时 1 次，测速会占用路由器 CPU 和网络资源。
#
# Recommended schedule:
#   Run every 6 hours: 0 */6 * * * /path/to/cf-openwrt-auto.sh
#   Use once per day for stable networks, or every 3 hours for unstable networks.
#   Avoid running more often than once per hour because speed tests consume CPU
#   and network resources.

# 配置文件版本：
#   脚本会检查 CONFIG_VERSION 是否满足最低配置版本要求。
#   不要删除这一项；升级模板时按新模板同步更新。
#
# Config version:
#   The script checks CONFIG_VERSION against the minimum required config version.
#   Do not remove this value; update it when you refresh this config from the template.

CONFIG_VERSION="1.3.0"

# 运行模式：
#   passwall  = 修改 PassWall 节点
#   openclash = 修改 OpenClash YAML 里的代理节点
#
# Mode:
#   passwall  = update PassWall nodes
#   openclash = update OpenClash YAML proxies

MODE="passwall"

# 工作目录：
#   留空表示使用脚本所在目录。
#   cfst 二进制、测速结果 cf_result.txt、历史 IP ip-all.txt 都会保存在这里。
#
# Work directory:
#   Leave empty to use the script directory.
#   cfst binary, cf_result.txt, and ip-all.txt will be stored here.

WORK_DIR=""

# 优选 IP 数量：
#   默认保留 4 个最快 IP。
#   如果实际测速结果不足 4 个，会用最快的第 1 个 IP 自动补齐。
#
# IP count:
#   Keep the fastest 4 IPs by default.
#   If fewer IPs are found, the fastest one is reused.

IP_COUNT="4"

# IP 类型：
#   ipv4 = 只测 IPv4 地址（使用 ip.txt）
#   ipv6 = 只测 IPv6 地址（使用 ipv6.txt）
#   both = 同时测 IPv4 和 IPv6（先 ip.txt 再 ipv6.txt，合并结果）
#
# IP type:
#   ipv4 = test IPv4 only (uses ip.txt)
#   ipv6 = test IPv6 only (uses ipv6.txt)
#   both = test both IPv4 and IPv6 (ip.txt then ipv6.txt, merged results)

IP_TYPE="ipv4"

# CloudflareSpeedTest 测速参数：
#   SPEEDTEST_PROTOCOL = 测速协议，对应 cfst -httping
#     tcp  = TCPing 模式（默认），测 TCP 连接延迟，速度快
#     http = HTTPing 模式，测 HTTP 响应延迟，更贴近实际使用场景
#   SPEEDTEST_CFCOLO   = HTTPing 模式下按 Cloudflare 数据中心筛选，对应 cfst -cfcolo
#     留空不筛选；多个用逗号分隔，如 HKG,NRT,LAX
#     仅 SPEEDTEST_PROTOCOL=http 时生效
#   SPEEDTEST_DN       = 下载测速数量，对应 cfst -dn
#   SPEEDTEST_TLL      = 平均延迟上限，对应 cfst -tll
#
# CloudflareSpeedTest options:
#   SPEEDTEST_PROTOCOL = test protocol, maps to cfst -httping
#     tcp  = TCPing mode (default), measures TCP connection latency, faster
#     http = HTTPing mode, measures HTTP response latency, more realistic
#   SPEEDTEST_CFCOLO   = filter by Cloudflare data center in HTTPing mode, maps to cfst -cfcolo
#     Leave empty to skip filtering; comma-separated, e.g. HKG,NRT,LAX
#     Only effective when SPEEDTEST_PROTOCOL=http
#   SPEEDTEST_DN       maps to cfst -dn
#   SPEEDTEST_TLL      maps to cfst -tll

SPEEDTEST_PROTOCOL="tcp"
SPEEDTEST_CFCOLO=""
SPEEDTEST_DN="10"
SPEEDTEST_TLL="40"

# PassWall 目标域名：
#   脚本会扫描 `uci show passwall`。
#   只修改 address 等于该域名的节点。
#
# PassWall target domain:
#   The script scans `uci show passwall`.
#   Only nodes whose address equals this domain are updated.

PASSWALL_TARGET_DOMAIN="cdn.example.com"

# PassWall 节点名称后缀：
#   修改节点后，在原始名称后面追加的后缀。
#   支持占位符：{n} = 序号（从 1 开始），{ip} = 优选 IP 地址。
#   留空则不修改节点名称。
#   示例：
#     " [CF-{n}]"   → "节点名 [CF-1]"、"节点名 [CF-2]"...
#     " [CF-{ip}]"  → "节点名 [CF-104.18.1.1]"...
#     ""             → 不修改名称
#
# PassWall node name suffix:
#   Suffix appended to the original node name after update.
#   Placeholders: {n} = sequence number (starting from 1), {ip} = fast IP address.
#   Leave empty to keep original names unchanged.
#   Examples:
#     " [CF-{n}]"   → "Node [CF-1]", "Node [CF-2]"...
#     " [CF-{ip}]"  → "Node [CF-104.18.1.1]"...
#     ""             → do not modify names

PASSWALL_NAME_SUFFIX=" [CF-{n}]"

# OpenClash 目标：
#   OPENCLASH_CONFIG 是 OpenClash 当前使用的 YAML 配置文件路径。
#   只修改 server 等于 OPENCLASH_TARGET_DOMAIN 的代理节点。
#   server 会改成优选 IP；servername / Host 会保留为域名。
#
# OpenClash target:
#   OPENCLASH_CONFIG is the active YAML config path.
#   Only proxies whose server equals OPENCLASH_TARGET_DOMAIN are updated.
#   server is changed to a fast IP; servername and Host stay as the domain.

OPENCLASH_CONFIG="/etc/openclash/config/config.yaml"
OPENCLASH_TARGET_DOMAIN="cdn.example.com"

# OpenClash 节点名称后缀：
#   修改节点后，在原始名称后面追加的后缀。
#   支持占位符：{n} = 序号（从 1 开始），{ip} = 优选 IP 地址。
#   留空则不修改节点名称。
#   示例：
#     " [CF-{n}]"   → "节点名 [CF-1]"、"节点名 [CF-2]"...
#     " [CF-{ip}]"  → "节点名 [CF-104.18.1.1]"...
#     ""             → 不修改名称
#
# OpenClash node name suffix:
#   Suffix appended to the original proxy name after update.
#   Placeholders: {n} = sequence number (starting from 1), {ip} = fast IP address.
#   Leave empty to keep original names unchanged.
#   Examples:
#     " [CF-{n}]"   → "Node [CF-1]", "Node [CF-2]"...
#     " [CF-{ip}]"  → "Node [CF-104.18.1.1]"...
#     ""             → do not modify names

OPENCLASH_NAME_SUFFIX=" [CF-{n}]"

# OpenClash 传输协议过滤：
#   只修改指定传输协议的代理节点，留空则修改所有支持的节点。
#   可选值：ws / grpc / xhttp / h2 / http，多个用逗号分隔。
#   示例：
#     ""           = 不过滤，所有支持的节点都修改
#     "ws"         = 只修改 WebSocket 节点
#     "ws,xhttp"   = 只修改 WebSocket 和 XHTTP 节点
#
# OpenClash transport filter:
#   Only update proxies with the specified transport, leave empty to update all.
#   Values: ws / grpc / xhttp / h2 / http, comma-separated.
#   Examples:
#     ""           = no filter, update all supported proxies
#     "ws"         = only update WebSocket proxies
#     "ws,xhttp"   = only update WebSocket and XHTTP proxies

OPENCLASH_TRANSPORT_FILTER=""

# 脚本自升级：
#   true  = 启动时检查脚本版本，有新版就自动升级
#   false = 禁用脚本自动升级
#   自升级只替换脚本，不会覆盖本地 cf-openwrt-auto.conf。
#
# Self update:
#   true  = check this script version on startup and auto-upgrade if newer
#   false = never update this script automatically
#   The local cf-openwrt-auto.conf is never overwritten by self-update.

AUTO_UPDATE="true"
SELF_UPDATE_URL="https://raw.githubusercontent.com/hello-yunshu/use-cloudflare-ip/main/cf-openwrt-auto.sh"

# 下载重试：
#   GitHub 在路由器网络上偶尔会 TLS 失败或返回 403。
#   脚本会按下面次数重试自升级、版本查询和 cfst 下载。
#
# Download retries:
#   GitHub may fail with TLS errors or 403 on router networks.
#   These values control retries for self-update, release metadata, and cfst downloads.

DOWNLOAD_RETRIES="3"
DOWNLOAD_RETRY_DELAY="5"

# GitHub 下载镜像：
#   如果路由器无法直接访问 GitHub 下载（常见于中国大陆网络），
#   可以设置 GitHub 镜像加速下载。镜像 URL 会自动拼接到原始 GitHub 下载链接前面。
#   留空表示不使用镜像，直接从 GitHub 下载。
#   示例：
#     ""                          = 不使用镜像
#     "https://ghp.ci/"           = 使用 ghp.ci 镜像
#     "https://gh-proxy.com/"     = 使用 gh-proxy.com 镜像
#   仅对 GitHub 下载链接（cfst 二进制、脚本自升级）生效，不影响 API 查询。
#
# GitHub download mirror:
#   If the router cannot access GitHub downloads directly (common in mainland China),
#   set a GitHub mirror to accelerate downloads. The mirror URL is prepended to the
#   original GitHub download URL.
#   Leave empty to download directly from GitHub.
#   Examples:
#     ""                          = no mirror
#     "https://ghp.ci/"           = use ghp.ci mirror
#     "https://gh-proxy.com/"     = use gh-proxy.com mirror
#   Only applies to GitHub download URLs (cfst binary, script self-update), not API queries.

GITHUB_MIRROR=""

# 调试输出：
#   false = 成功时静默
#   true  = 输出过程日志到 stderr
#   手动排查时也可以不改配置，直接运行：
#     ./cf-openwrt-auto.sh --verbose
#
# Verbose:
#   false = silent on success
#   true  = print progress to stderr
#   For manual debugging, you can also run:
#     ./cf-openwrt-auto.sh --verbose

VERBOSE="false"
